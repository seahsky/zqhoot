# Development settings for `pnpm --filter @zqhoot/server-node dev`. Nothing here is a secret:
# never reuse these values on a server other people can reach.
# Variables already set in your shell win over this file.
ZQ_PORT=8080
ZQ_HOST=127.0.0.1
ZQ_PUBLIC_URL=http://localhost:8080
ZQ_DATA_DIR=./data
ZQ_ADMIN_USER=admin
ZQ_ADMIN_PASSWORD=dev-password
ZQ_JWT_SECRET=development-only-secret-do-not-use-in-production-0123456789
ZQ_LOG_LEVEL=debug
