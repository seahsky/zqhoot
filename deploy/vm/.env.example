# zqhoot VM stack: configuration for docker-compose.yml.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored and holds secrets: never commit it. Values that contain $ must stay in single
# quotes (Compose would otherwise expand them). A variable left empty counts as unset.
# Every ZQ_* variable of the server is listed in apps/server-node/README.md.
#
# The two secrets below are placeholders that the server rejects at startup on purpose: a file
# copied without editing does not run with a guessable secret.

# ---------------------------------------------------------------------------
# Caddy: address and TLS
# ---------------------------------------------------------------------------

# DNS name people type, without scheme or path. In acme mode its A/AAAA record must point at this
# machine and ports 80 and 443 must be reachable from the internet. Compose refuses to start without
# it in every mode; the http mode does not use it, so any value (localhost) will do there.
ZQ_DOMAIN=quiz.example.com

# How Caddy gets its certificate. One of:
#   acme      automatic certificate from a public CA (Let's Encrypt/ZeroSSL). Default.
#   files     your own certificate: put cert.pem and key.pem in ./certs (or ZQ_CERTS_DIR)
#   internal  Caddy's own CA, for networks without public DNS; devices must trust its root
#   http      plain HTTP on port 80. LOCAL TESTING ONLY: passwords cross the network in clear text
ZQ_TLS_MODE=acme

# Contact address for the certificate authority (expiry notices). Optional; acme mode only.
ZQ_ACME_EMAIL=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# The URL browsers use: an origin without a path. It must match ZQ_DOMAIN and the TLS mode, because
# the WebSocket Origin check compares against it exactly. Optional here: when unset, the stack uses
# https://$ZQ_DOMAIN. Set it for ZQ_TLS_MODE=http (for example http://localhost).
#ZQ_PUBLIC_URL=https://quiz.example.com

# The one host account. Quizzes belong to "local:<name>"; renaming it starts an empty account.
ZQ_ADMIN_USER=admin

# Password hash of that account. Generate it (prompts twice, prints only the hash):
#   docker compose run --rm app node hash-password.mjs
# and paste the output between single quotes.
ZQ_ADMIN_PASSWORD_HASH='CHANGE_ME'

# Development only, and only as a substitute for the hash (the hash wins when both are set).
# Never set this on a machine other people can reach.
#ZQ_ADMIN_PASSWORD=

# Signs host logins and media upload grants; at least 32 bytes. Generate one:
#   openssl rand -base64 48
# Changing it logs the host out and invalidates pending upload grants.
ZQ_JWT_SECRET=CHANGE_ME

# Days a session and its results are kept, counted from its creation. Quizzes never expire.
#ZQ_SESSION_TTL_DAYS=30

# debug, info, warn, error or silent
#ZQ_LOG_LEVEL=info

# Store: memory (state.json in the zqdata volume, the default) or dynamodb. DynamoDB needs the three
# settings below plus AWS credentials the container can reach (AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY here; the EC2 instance role is not visible from a container when the
# instance metadata hop limit is 1, which is what infra/terraform/modules/vm sets).
#ZQ_STORE=memory
#ZQ_TABLE_NAME=
#AWS_REGION=
# Only for DynamoDB Local.
#ZQ_DDB_ENDPOINT=

# ---------------------------------------------------------------------------
# Set by docker-compose.yml, listed for completeness. A value here is overridden there.
# ---------------------------------------------------------------------------

# The image serves on 8080 and stores data in /data; Caddy is the only client, so the app trusts
# its X-Forwarded-For header for the per-IP rate limits.
#ZQ_PORT=8080
#ZQ_HOST=0.0.0.0
#ZQ_DATA_DIR=/data
#ZQ_WEB_DIST=/app/web
#ZQ_TRUST_PROXY=true

# ---------------------------------------------------------------------------
# Compose options (optional)
# ---------------------------------------------------------------------------

# Host ports for Caddy. Leave the defaults on a real server: ACME needs 80 and 443.
#ZQ_HTTP_PORT=80
#ZQ_HTTPS_PORT=443

# Listen on this address only (for example 127.0.0.1) instead of all interfaces.
#ZQ_BIND_ADDRESS=

# Directory with cert.pem and key.pem for ZQ_TLS_MODE=files, relative to this folder or absolute.
#ZQ_CERTS_DIR=./certs

# Image name Compose builds and runs.
#ZQ_IMAGE=zqhoot:local

# Recorded in the image's OCI labels (org.opencontainers.image.version and .revision). Better set in
# the shell that builds than here, so the value is the current one:
#   ZQ_REVISION=$(git rev-parse HEAD) docker compose up -d --build
#ZQ_VERSION=dev
#ZQ_REVISION=unknown
